{
  "name": "alayn-backend",
  "version": "1.0.0",
  "description": "Alayn Operations & Management Platform Phase 1 Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts,json --exec ts-node --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "generate": "npx prisma generate",
    "migration": "npx prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node prisma/seed.ts",
    "seed:admin": "ts-node prisma/seedAdmin.ts",
    "seed:refresh": "ts-node prisma/seedRefresh.ts",
    "seed:drnk": "ts-node prisma/seedDRNK.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.569.0",
    "@prisma/client": "^6.10.1",
    "@types/mime-types": "^2.1.4",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^5.1.1",
    "bullmq": "5.8.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "pino": "^8.21.0",
    "pino-pretty": "^11.0.0",
    "redis": "^4.6.13",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.10.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
