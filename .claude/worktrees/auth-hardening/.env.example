PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_db?schema=public"

# Redis holds every login session, rate-limit counter and password-reset code.
# In production it is REQUIRED: if Redis is down, sign-in and authenticated requests fail closed (503).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true

# Auth secrets. In production (NODE_ENV=production) the server refuses to start unless BOTH are set,
# are at least 32 characters, are different from each other and are not the sample values below.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=super_secret_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_token_key_54321

# Optional auth tuning
# COOKIE_DOMAIN=.example.com   # unset = ".alaynai.com" in production, host-only elsewhere; empty = host-only
# SESSION_MAX_DAYS=90          # a login can never be kept alive by refreshing for longer than this
# MAX_SESSIONS_PER_USER=25     # simultaneous logins per account; the oldest is signed out beyond this

# Cashfree Payment Gateway Credentials
CASHFREE_APP_ID=TEST1234567890abcdef
CASHFREE_SECRET_KEY=TEST_secret_key_1234567890abcdef
CASHFREE_ENV=SANDBOX # 'SANDBOX' for testing, 'PRODUCTION' for live
CASHFREE_API_VERSION=2023-08-01

# Subscription Pricing (in Paise: 199900 = Rs 1,999/month + GST)
OUTLET_MONTHLY_FEE_PAISE=199900
